PORT=4343
PSQL_CONN="postgres://user:pass@host:5432/url?sslmode=disable"

# --- login vía mier id (oidc backend-for-frontend) ---
# emisor del idp (sin barra final)
OIDC_ISSUER="https://id.mier.info"
# credenciales del cliente confidential registrado en mier id (admin -> clientes)
OIDC_CLIENT_ID="tu_client_id"
OIDC_CLIENT_SECRET="tu_client_secret"
# callback registrado en el cliente; debe coincidir EXACTO con el de mier id
OIDC_REDIRECT_URL="https://url.mier.info/auth/callback"
# a donde vuelve el navegador tras cerrar sesion en el idp (opcional; registrar en el cliente)
OIDC_POST_LOGOUT_URL="https://url.mier.info/"
